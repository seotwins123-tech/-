const css=document.createElement('style');css.textContent='#lb{position:fixed;inset:0;z-index:99999;display:flex;align-items:center;justify-content:center;background:radial-gradient(circle at 50% 30%,#2b3a67,#0d1226);font-family:sans-serif;color:#fff}#lb .c{width:min(380px,92vw);padding:22px 20px;border-radius:20px;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.25);text-align:center}#lb h2{margin:0 0 4px;font-size:22px}#lb p{margin:6px 0 14px;font-size:13px;opacity:.8}#lb button{width:100%;height:48px;margin:5px 0;border:0;border-radius:14px;font-size:16px;font-weight:700;color:#fff;background:#3b82f6}#lb button.g{background:rgba(255,255,255,.2)}#lb input{width:100%;box-sizing:border-box;height:48px;margin:5px 0;border-radius:14px;border:1px solid rgba(255,255,255,.4);background:rgba(0,0,0,.35);color:#fff;font-size:20px;letter-spacing:6px;text-align:center;text-transform:uppercase;outline:none}#lbs{min-height:20px;margin-top:8px;font-size:13px;color:#ffd966}#lbk{font-size:44px;font-weight:800;letter-spacing:8px;margin:6px 0}#lbn{font-size:14px;font-weight:700;margin-bottom:6px}#lbp{position:fixed;top:6px;left:50%;transform:translateX(-50%);z-index:60;padding:3px 10px;border-radius:12px;background:rgba(0,0,0,.55);color:#fff;font:700 12px sans-serif;display:none}';document.head.appendChild(css);
const box=document.createElement('div');box.id='lb';box.innerHTML='<div class="c"><h2>🌆 서울 힐링 월드</h2><p>최대 3명이 같이 하는 멀티플레이</p><div id="lm"><button id="lh">🏠 방 만들기</button><input id="li" maxlength="6" placeholder="방 코드" autocomplete="off" autocapitalize="characters"><button id="lj">🔑 코드 입력 입장</button><button id="ls" class="g">🙋 혼자 하기</button></div><div id="lw" style="display:none"><p>이 코드를 친구들에게 알려 주세요 (최대 3명)</p><div id="lbk"></div><div id="lbn"></div><button id="lc" class="g">📋 코드 복사</button><button id="lx" class="g">취소</button></div><div id="lbs"></div></div>';document.body.appendChild(box);
const pill=document.createElement('div');pill.id='lbp';document.body.appendChild(pill);
const $l=id=>document.getElementById(id),st=t=>{$l('lbs').textContent=t||''};
const page=w=>{$l('lm').style.display=w?'none':'block';$l('lw').style.display=w?'block':'none'};
const show=t=>{box.style.display='flex';page(0);st(t)},hide=()=>{box.style.display='none'};
const setPill=t=>{pill.textContent=t||'';pill.style.display=t?'block':'none'};
function upd(){if(!NP.up)return;setPill('🟢 '+cnt()+'/'+MAXP+'명 · 방 '+NP.code);$l('lbn').textContent='현재 '+cnt()+'/'+MAXP+'명';$l('lx').textContent=ids().length?'닫기':'취소'}
pill.addEventListener('pointerdown',()=>{if(NP.up){$l('lbk').textContent=NP.code;page(1);box.style.display='flex';st('');upd()}else show()});
function reset(){const gone=ids().map(id=>({peer:id}));for(const id in NP.conns)try{NP.conns[id].close()}catch(e){}try{NP.hc&&NP.hc.close()}catch(e){}try{NP.peer&&NP.peer.destroy()}catch(e){}
 NP.conns={};NP.pend=0;NP.hc=null;NP.peer=null;NP.rem={};NP.last={};NP.sent={};NP.up=false;NP.host=false;room=null;if(gone.length)fire([],gone)}
function err(e){const t=e&&e.type;reset();setPill('');show(t==='full'?'방이 가득 찼어요 (최대 3명)':t==='peer-unavailable'?'그 코드의 방을 찾을 수 없어요. 코드를 다시 확인해 주세요':t==='timeout'?'연결 시간이 초과됐어요. 다시 시도해 주세요':(t==='network'||t==='server-error'||t==='socket-error'||t==='socket-closed')?'연결 서버에 접속하지 못했어요. 잠시 후 다시 시도해 주세요':'연결 오류: '+(t||'알 수 없음'))}
function lost(){if(!NP.up)return;reset();setPill('🔴 연결이 끊겼어요 (눌러서 다시 연결)');show('연결이 끊겼어요. 다시 연결해 주세요')}
function got(from,p){if(!p||typeof p!=='object')return;const f=!NP.rem[from];NP.rem[from]=Object.assign(NP.rem[from]||{},p);fire(f?[ent(from)]:[],[])}
function drop(id){const had=!!NP.rem[id];delete NP.conns[id];delete NP.rem[id];delete NP.last[id];bcast({l:id});if(had)fire([],[{peer:id}]);else upd()}
function onConn(c){if(Object.keys(NP.conns).length+NP.pend>=MAXP-1){c.on('open',()=>{send(c,{full:1});setTimeout(()=>{try{c.close()}catch(e){}},400)});return}
 const id=gid(c);let s=0;NP.pend++;
 c.on('open',()=>{if(s)return;s=1;NP.pend--;NP.conns[id]=c;NP.last[id]=Date.now();send(c,{from:HID,p:NP.state});for(const o of ids())if(o!==id)send(c,{from:o,p:NP.rem[o]});if(box.style.display!=='none')hide();upd()});
 c.on('data',m=>{NP.last[id]=Date.now();if(m&&m.p&&typeof m.p==='object'){bcast({from:id,p:m.p},id);got(id,m.p)}});
 const gone=()=>{if(s===0)NP.pend=Math.max(0,NP.pend-1);else if(s===1&&NP.conns[id]===c)drop(id);s=2};c.on('close',gone);c.on('error',gone)}
function onHost(c){NP.hc=c;
 c.on('open',()=>{NP.up=true;NP.last[HID]=Date.now();NP.sent={};const d={};for(const k in NP.state){NP.sent[k]=JSON.stringify(NP.state[k]);d[k]=NP.state[k]}send(c,{p:d});room=NP;hide();upd()});
 c.on('data',m=>{NP.last[HID]=Date.now();if(!m||m.h)return;if(m.full){err({type:'full'});return}if(m.l){if(NP.rem[m.l]){delete NP.rem[m.l];fire([],[{peer:m.l}])}return}if(m.from)got(m.from,m.p)});
 c.on('close',lost);c.on('error',lost)}
function host(){reset();st('방을 만드는 중…');let n=0;const mk=()=>{NP.code=Array.from({length:5},()=>CS[Math.random()*CS.length|0]).join('');const pr=new Peer(PFX+NP.code);NP.peer=pr;NP.host=true;
 pr.on('open',()=>{NP.up=true;room=NP;$l('lbk').textContent=NP.code;page(1);st('친구들이 입장하기를 기다리는 중…');upd()});pr.on('connection',onConn);pr.on('disconnected',()=>{try{pr.reconnect()}catch(e){}});
 pr.on('error',e=>{if(e.type==='unavailable-id'&&n++<5){try{pr.destroy()}catch(x){}mk()}else err(e)})};mk()}
function join(){const code=$l('li').value.trim().toUpperCase();if(code.length<4){st('방 코드를 입력해 주세요');return}reset();NP.code=code;st('연결 중…');const pr=new Peer();NP.peer=pr;
 pr.on('open',()=>{onHost(pr.connect(PFX+code,{serialization:'json',reliable:true}));setTimeout(()=>{if(NP.peer===pr&&!NP.up)err({type:'timeout'})},15000)});pr.on('error',err)}
const noLib=()=>typeof Peer==='undefined'?(st('멀티플레이 라이브러리를 불러오지 못했어요. 인터넷을 확인해 주세요'),true):false;
$l('lh').addEventListener('click',()=>{if(!noLib())host()});$l('lj').addEventListener('click',()=>{if(!noLib())join()});
$l('ls').addEventListener('click',()=>{hide();setPill('')});
$l('lx').addEventListener('click',()=>{if(NP.up&&ids().length){hide()}else{reset();setPill('');show()}});
$l('lc').addEventListener('click',()=>{try{navigator.clipboard.writeText(NP.code);st('코드를 복사했어요: '+NP.code)}catch(e){st('코드: '+NP.code)}});
$l('li').addEventListener('keydown',e=>{e.stopPropagation();if(e.key==='Enter'&&!e.isComposing)join()});$l('li').addEventListener('keyup',e=>e.stopPropagation());
setInterval(()=>{if(!NP.up)return;const n=Date.now();if(NP.host){for(const id of Object.keys(NP.conns)){const c=NP.conns[id];send(c,{h:1});if(n-NP.last[id]>12000){try{c.close()}catch(e){}drop(id)}}}else{send(NP.hc,{h:1});if(n-NP.last[HID]>12000)lost()}},2000);
addEventListener('beforeunload',()=>{try{NP.peer&&NP.peer.destroy()}catch(e){}});
window.NP=NP;
})();
</script></body></html>
